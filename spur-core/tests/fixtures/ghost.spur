// A node that tells every peer about each write it takes and about each
// timer firing, so a crash of the node routinely leaves its own messages in
// the air; a peer that consumes one of them while the sender is down, or
// after the sender has come back, has taken a fault-crossing delivery. The
// peer's handler writes state, so that delivery counts as one that acted.
//
// The peer list carries the node itself, and a message a node sends to
// itself is never in flight, so the loops skip it.

type Cluster {
    @quorum nodes: list<Node>;
};

type ClusterParams {
    @scale n: int;
};

role Node(cluster: Cluster) {
    var db: map<string, int> = {};
    var seen: int = 0;
    var me: int = index_of(cluster.nodes, self)!;
    var peers: list<Node> = cluster.nodes;

    fn Init() {
        Heartbeat();
    }

    async fn RecoverInit() {
        Heartbeat();
    }

    async fn Heartbeat() {
        for ;; {
            <- set_timer("beat");
            seen = seen + 1;
            for var i = 0; i < len(peers); i = i + 1 {
                if (i != me) {
                    peers[i]->Note(seen);
                }
            }
        }
    }

    async fn Note(n: int) {
        seen = n;
    }

    async fn Write(key: string, uid: int): bool {
        for var i = 0; i < len(peers); i = i + 1 {
            if (i != me) {
                peers[i]->Note(uid);
            }
        }
        db = db[key] := uid;
        return true;
    }

    async fn Read(key: string): int {
        if (exists(db, key)) {
            return db[key];
        }
        return 0;
    }
}

fn cluster(n: int): Cluster {
    var nodes: list<Node> = spawn<Node>(n);
    var c: Cluster = Cluster { nodes: nodes };
    provide_all(nodes, c);
    c
}

@deploy(client = KVClient)
fn Main(p: ClusterParams): Cluster? {
    if (p.n < 1) {
        return nil;
    }
    cluster(p.n)
}

client KVClient(sys: Cluster) {
    async fn Write(dest: Node, key: string, uid: int) {
        <-dest->Write(key, uid);
    }

    async fn Read(dest: Node, key: string): list<int> {
        return [<-dest->Read(key)];
    }
}
