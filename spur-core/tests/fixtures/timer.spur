// A key-value store whose nodes run two timer loops: one whose firing writes
// node state and one whose firing changes nothing. Used by tests that measure
// what a timer firing does to the node that waited for it.

type Cluster {
    @quorum nodes: list<Node>;
};

type ClusterParams {
    @scale n: int;
};

role Node(cluster: Cluster) {
    var db: map<string, int> = {};
    var ticks: int = 0;

    fn Init() {
        Tick();
        Idle();
    }

    async fn Tick() {
        for ;; {
            <- set_timer("tick");
            ticks = ticks + 1;
        }
    }

    async fn Idle() {
        for ;; {
            <- set_timer("idle");
        }
    }

    async fn Write(key: string, uid: int): bool {
        db = db[key] := uid;
        return true;
    }

    async fn Read(key: string): int {
        if (exists(db, key)) {
            return db[key];
        }
        return 0;
    }
}

fn cluster(n: int): Cluster {
    var nodes: list<Node> = spawn<Node>(n);
    var c: Cluster = Cluster { nodes: nodes };
    provide_all(nodes, c);
    c
}

@deploy(client = KVClient)
fn Main(p: ClusterParams): Cluster? {
    if (p.n < 1) {
        return nil;
    }
    cluster(p.n)
}

client KVClient(sys: Cluster) {
    async fn Write(dest: Node, key: string, uid: int) {
        <-dest->Write(key, uid);
    }

    async fn Read(dest: Node, key: string): list<int> {
        return [<-dest->Read(key)];
    }
}
